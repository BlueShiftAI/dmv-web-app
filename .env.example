# =============================================================================
# DMV Web App — Environment Template
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL (matches docker-compose.yml service names)
# ---------------------------------------------------------------------------
POSTGRES_USER=dmvapp
POSTGRES_PASSWORD=changeme
POSTGRES_DB=dmvdb
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full connection URL (used by SQLAlchemy / Alembic)
# Constructed from the values above — override only if needed
DATABASE_URL=postgresql+psycopg2://dmvapp:changeme@db:5432/dmvdb

# ---------------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------------
# Secret key for JWT signing — generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-random-secret-key-at-least-32-chars

# JWT token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Upload storage root (outside publicly served directories)
UPLOAD_DIR=/app/uploads

# Max upload size in bytes (default 10 MB)
MAX_UPLOAD_SIZE_BYTES=10485760

# Demo mode flag — set to "true" to enable synthetic data endpoints
DEMO_MODE=true

# ---------------------------------------------------------------------------
# Frontend (Vite)
# VITE_ prefix required for browser-visible variables
# Do NOT put secrets here
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# Set to "true" to enable the mock Orchestrate assistant when credentials absent
VITE_ORCHESTRATE_MOCK=true

# ---------------------------------------------------------------------------
# IBM watsonx Orchestrate (server-side only — never expose in browser)
# ---------------------------------------------------------------------------
# ORCHESTRATE_API_KEY=your-api-key-here
# ORCHESTRATE_INSTANCE_URL=https://your-instance.us-south.watsonx.ai
# ORCHESTRATE_AGENT_ID=your-agent-id

# ---------------------------------------------------------------------------
# Web Push (VAPID keys — generate with: npx web-push generate-vapid-keys)
# ---------------------------------------------------------------------------
# VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_MAILTO=mailto:admin@example.com

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=America/New_York
